# Kopiraj u .env.local i popuni. .env.local se nikad ne komituje.

# Aplikacija
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (lokalno: vrednosti iz `npx supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_TEXT_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_FALLBACK_MODEL=gemini-3.1-flash-lite-image

# Stripe (test ključevi u DEV, live samo u Vercel Production)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# Impersonacija (32+ nasumičnih znakova, npr. `openssl rand -hex 32`)
IMPERSONATION_SECRET=

# Vercel Cron (Settings → Environment Variables; Vercel ga sam šalje cron-u)
CRON_SECRET=
