# Sova — env varijable. Kopiraj u .env.local i popuni. NIKAD ne komituj .env.local.
# U DEV su opcione sve osim bloka "obavezno uvek" (docs/DECISIONS.md D-014).

# ---------- Aplikacija (obavezno uvek) ----------
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ---------- Supabase (obavezno uvek) ----------
# Lokalno: vrednosti ispisuje `npx supabase start` / `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Samo ako projekat koristi HS256 JWT secret (impersonacija, faza 13).
SUPABASE_JWT_SECRET=

# ---------- Tajne aplikacije (obavezno uvek) ----------
# TOKEN_ENCRYPTION_KEY: v1:<base64 32 bajta>. Napravi: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# CRON_SECRET i IMPERSONATION_SECRET: openssl rand -hex 32
CRON_SECRET=
IMPERSONATION_SECRET=

# ---------- Gemini ----------
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_TEXT_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_PREMIUM_MODEL=gemini-3-pro-image
GEMINI_IMAGE_FALLBACK_MODEL=gemini-3.1-flash-lite-image
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# ---------- Vizuali ----------
UNSPLASH_ACCESS_KEY=
UNSPLASH_APP_NAME=sova
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# Opciono, za SPA sajtove u Brand Brain-u
FIRECRAWL_API_KEY=

# ---------- Društvene mreže ----------
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
META_LOGIN_CONFIG_ID=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202610
# true tek kad LinkedIn odobri Community Management API (stranice) i Member Post Analytics
LINKEDIN_PAGES=false
LINKEDIN_MEMBER_ANALYTICS=false
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# domen verifikovan u TikTok portalu (URL properties); prazno = NEXT_PUBLIC_APP_URL
PUBLIC_MEDIA_BASE_URL=
# najveći video u biblioteci u MB (Supabase besplatan plan: 50)
MEDIA_MAX_VIDEO_MB=50
X_CLIENT_ID=
X_CLIENT_SECRET=
# Google: prijava, YouTube, Google Business Profile
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# true dok Pinterest app ima samo Trial pristup (pinovi vidljivi samo autoru)
PINTEREST_SANDBOX=false

# ---------- Plaćanje ----------
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_AUTOMATIC_TAX=false

# ---------- Background i infrastruktura ----------
# Lokalno nisu potrebni: `npx inngest-cli@latest dev` radi bez ključeva.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Bez Upstash-a DEV koristi rate limit u memoriji procesa.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- Email ----------
RESEND_API_KEY=
EMAIL_FROM="Sova <noreply@sovaai.rs>"

# ---------- Monitoring i zaštita ----------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---------- Crawler ----------
BOT_INFO_URL=https://sovaai.rs/bot
# LOG_LEVEL=debug|info|warn|error (podrazumevano: debug u dev, info u prod)
