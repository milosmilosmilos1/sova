{
  "name": "sova",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:db": "node --env-file=.env.local scripts/test-db.mjs",
    "test:auth": "node --env-file=.env.local scripts/test-auth.mjs",
    "test:generate": "node --env-file=.env.local scripts/test-generate.mjs --no-image",
    "test:generate:full": "node --env-file=.env.local scripts/test-generate.mjs",
    "test:stripe": "node --env-file=.env.local scripts/test-stripe.mjs",
    "test:admin": "node --env-file=.env.local scripts/test-admin.mjs",
    "test:all": "npm run test:db && npm run test:auth && npm run test:generate && npm run test:stripe && npm run test:admin",
    "check:gemini": "node --env-file=.env.local scripts/check-gemini.mjs",
    "make-admin": "node --env-file=.env.local scripts/make-admin.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "stripe": "^23.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "supabase": "^2.121.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
